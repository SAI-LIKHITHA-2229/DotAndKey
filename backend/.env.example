# Environment variables read by app.py. Set them in your shell or hosting
# provider; every one has a safe development default except SECRET_KEY in
# production.

# development | production (production refuses to start without SECRET_KEY)
APP_ENV=development

# Signs login tokens. Use a long random value (32+ bytes), e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file (defaults to backend/cart.db)
DATABASE_PATH=

PORT=5001
