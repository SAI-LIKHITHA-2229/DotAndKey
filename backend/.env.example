# Environment variables read by the API (api/config.py). Put local values in
# backend/.env (never committed), or set them in your shell or hosting
# provider; a real environment variable wins over the file. Every one has a
# safe development default except SECRET_KEY in production.

# development | production (production refuses to start without SECRET_KEY,
# sends the session cookie only over HTTPS and adds HSTS)
APP_ENV=development

# Signs login tokens. Use a long random value (32+ bytes), e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated frontend origins allowed to call the API cross-origin.
# Not needed when the frontend reaches the API through a same-origin proxy.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection. Special characters in the password must be
# URL-encoded; scripts/set-db-url.ps1 fills this in safely in backend/.env.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/dotandkey

# Optional: the database the tests use. They erase it, so its name must be
# dotandkey_test. Defaults to DATABASE_URL with the name changed.
TEST_DATABASE_URL=

# Host/port for serve.py (production) and app.py (development)
HOST=0.0.0.0
PORT=5001

# Number of reverse proxies in front of the API (0 = none). Needed for
# correct client IPs in rate limiting; never set it without a real proxy.
TRUST_PROXY=0

# Override cookie HTTPS-only behaviour (defaults to true in production)
SESSION_COOKIE_SECURE=

# Rate limiting on /login and /register. Use a shared store such as
# redis://localhost:6379 when running more than one server process.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
